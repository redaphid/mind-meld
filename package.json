{
  "name": "@redaphid/mindmeld",
  "version": "1.21.0",
  "description": "Unified conversation index for Claude Code with PostgreSQL + Chroma",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redaphid/mind-meld.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "bin": {
    "mindmeld": "dist/index.js"
  },
  "//files": "Allowlist, not a denylist: without this every published tarball packs the whole working tree (issue #64 — this repo is public and release.yml publishes on every version bump). init-db is required at runtime, not optional: src/db/migrations.ts reads it from ../../init-db.",
  "files": [
    "dist",
    "init-db",
    "README.md"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc",
    "build:binary": "bun build --compile src/index.ts --outfile out/mindmeld",
    "dev": "tsx watch src/mcp/http-server.ts",
    "start": "node dist/index.js",
    "sync": "tsx src/index.ts sync",
    "sync:claude": "tsx src/index.ts sync --source claude_code",
    "sync:embeddings": "tsx src/index.ts embeddings",
    "summarize:transcript": "tsx scripts/summarize-transcript.ts",
    "verify": "tsx src/index.ts verify",
    "compute:centroids": "tsx scripts/compute-centroids.ts",
    "mark:warmups": "tsx scripts/mark-warmups.ts",
    "quarantine": "tsx scripts/retry-quarantine.ts",
    "strip:scaffolding": "tsx scripts/strip-scaffolding.ts",
    "icons": "node scripts/make-icons.mjs",
    "search": "tsx scripts/search.ts",
    "stats": "tsx scripts/stats.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "docker compose down -v && docker compose up -d",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:dev": "tsx watch src/mcp/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "quality": "pnpm run test:coverage && pnpm run quality:knip && pnpm run quality:coverage",
    "quality:knip": "tsx scripts/quality/knip-ratchet.ts",
    "quality:coverage": "tsx scripts/quality/coverage-ratchet.ts",
    "//quality:sw-shell": "Re-records quality/service-worker-shell.json. The CHECK runs in the normal test suite (src/quality/service-worker-freshness.test.ts); this is only the deliberate way to re-record after bumping VERSION in public/sw.js. Kept out of quality:update on purpose — see issue #113.",
    "quality:sw-shell": "tsx scripts/quality/sw-shell-digest.ts",
    "quality:update": "pnpm run test:coverage && tsx scripts/quality/knip-ratchet.ts --update && tsx scripts/quality/coverage-ratchet.ts --update",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@chroma-core/ollama": "^0.1.8",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@types/express": "^5.0.6",
    "chromadb": "^3.1.6",
    "chrono-node": "^2.9.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ms": "^2.1.3",
    "ollama": "^0.5.11",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.9",
    "knip": "^6.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6",
    "yaml": "^2.9.0"
  }
}
