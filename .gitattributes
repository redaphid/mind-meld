# These run in git-bash on the Windows host and on the Actions runner. CRLF
# breaks both, so pin them regardless of the checkout's autocrlf setting.
# Scoped to the coordinator toolchain to avoid colliding with the repo-wide
# line-ending pass still in flight on another branch.
scripts/coord/*.sh text eol=lf
.claude/hooks/*.sh text eol=lf
.github/workflows/*.yml text eol=lf
