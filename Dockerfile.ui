FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install pnpm and dependencies
RUN corepack enable && \
    corepack prepare pnpm@latest --activate && \
    pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Expose HTTP port
EXPOSE 3000

# Run the UI server (static public/ + reverse proxy to the mcp service)
CMD ["npx", "tsx", "src/ui/server.ts"]
