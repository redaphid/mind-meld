{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // Every ignore in this file MUST carry a justification comment.
  // See docs/quality-ratchet.md — unexplained ignore sprawl counts as
  // cheating the ratchet and will be rejected in review.
  "entry": [
    // src/index.ts (main/bin) and src/mcp/{server,http-server}.ts are picked
    // up automatically from package.json, so they are not listed here.
    // scripts/ is excluded from tsconfig but still real, executed code
    // (package.json scripts, Dockerfiles, cron). Each file is a standalone
    // tsx/node entry point, so scan them all as entries.
    "scripts/*.ts",
    "scripts/*.mjs",
    // Ratchet checkers, run by CI and pnpm quality:*.
    "scripts/quality/*.ts",
    // Comms-protocol enforcement (issue #75). These are provider-agnostic
    // standalone node entry points on purpose: an agent runtime invokes them
    // from its own hook configuration (for Claude Code, .claude/settings.json),
    // `pnpm run reconcile:labels` invokes one directly, and a human or CI can
    // run any of them by hand. Nothing under src/ imports them, so knip cannot
    // discover them — but they are executed code, covered by
    // src/__tests__/comms-hooks.test.ts.
    "scripts/comms/*.mjs",
    // Ad-hoc investigation scripts, run manually with tsx. Kept scanned so
    // the deps/exports they use are not falsely reported as unused.
    "scripts/test/*.ts",
    // The ui container's entry point, launched only by Dockerfile.ui's CMD
    // ("npx tsx src/ui/server.ts") — nothing in package.json references it,
    // so knip cannot discover it on its own.
    "src/ui/server.ts"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.{ts,mjs}"]
}
